@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <div class="hero-section py-5 mb-5" style="background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); border-radius: var(--border-radius); color: white;">
        <div class="container">
            <h1 class="display-4 fw-bold mb-4">
                <i class="fas fa-cash-register me-3"></i>Professional POS System
            </h1>
            <p class="lead mb-4">Complete point of sale solution with inventory management, sales tracking, and professional reporting.</p>
            @if (User.Identity.IsAuthenticated)
            {
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <a asp-page="/POS" class="btn btn-light btn-lg w-100 h-100 d-flex flex-column justify-content-center">
                                    <i class="fas fa-shopping-cart fa-2x mb-2"></i>
                                    <span>Start Selling</span>
                                </a>
                            </div>
                            <div class="col-md-4 mb-3">
                                <a asp-page="/Products/Index" class="btn btn-light btn-lg w-100 h-100 d-flex flex-column justify-content-center">
                                    <i class="fas fa-box fa-2x mb-2"></i>
                                    <span>Manage Products</span>
                                </a>
                            </div>
                            <div class="col-md-4 mb-3">
                                <a asp-page="/Sales/Index" class="btn btn-light btn-lg w-100 h-100 d-flex flex-column justify-content-center">
                                    <i class="fas fa-chart-line fa-2x mb-2"></i>
                                    <span>View Reports</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="mt-4">
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-light btn-lg me-3">
                        <i class="fas fa-user-plus me-2"></i>Get Started
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-sign-in-alt me-2"></i>Sign In
                    </a>
                </div>
            }
        </div>
    </div>

    @if (User.Identity.IsAuthenticated)
    {
        <div class="row mb-5">
            <div class="col-md-4 mb-4">
                <div class="stats-card">
                    <i class="fas fa-store fa-2x" style="color: var(--accent-color);"></i>
                    <h5>Complete POS</h5>
                    <p class="card-text">Full-featured point of sale system with real-time inventory tracking</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="stats-card" style="border-left-color: var(--success-color);">
                    <i class="fas fa-chart-bar fa-2x" style="color: var(--success-color);"></i>
                    <h5>Sales Analytics</h5>
                    <p class="card-text">Comprehensive reporting and analytics for business insights</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="stats-card" style="border-left-color: var(--warning-color);">
                    <i class="fas fa-boxes fa-2x" style="color: var(--warning-color);"></i>
                    <h5>Inventory Management</h5>
                    <p class="card-text">Track stock levels and manage your product catalog efficiently</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-5">
            <div class="col-md-6 offset-md-3">
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-lock fa-3x text-muted mb-4"></i>
                        <h4>Welcome to Professional POS</h4>
                        <p class="text-muted mb-4">Please sign in to access the point of sale system and manage your business operations.</p>
                        <div>
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg me-3">
                                <i class="fas fa-sign-in-alt me-2"></i>Sign In
                            </a>
                            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary btn-lg">
                                <i class="fas fa-user-plus me-2"></i>Register
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
