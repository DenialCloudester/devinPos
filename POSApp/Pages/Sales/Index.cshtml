@page
@model POSApp.Pages.Sales.IndexModel
@{
    ViewData["Title"] = "Sales History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-chart-line me-2"></i>Sales History</h2>
    <div>
        <span class="badge bg-primary fs-6">Total Sales: $@Model.TotalSales.ToString("F2")</span>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="fas fa-shopping-cart fa-2x text-primary mb-2"></i>
                <h5 class="card-title">@Model.TotalTransactions</h5>
                <p class="card-text text-muted">Total Transactions</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="fas fa-dollar-sign fa-2x text-success mb-2"></i>
                <h5 class="card-title">$@Model.TotalSales.ToString("F2")</h5>
                <p class="card-text text-muted">Total Revenue</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="fas fa-calendar-day fa-2x text-info mb-2"></i>
                <h5 class="card-title">$@Model.TodaySales.ToString("F2")</h5>
                <p class="card-text text-muted">Today's Sales</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="fas fa-chart-bar fa-2x text-warning mb-2"></i>
                <h5 class="card-title">$@Model.AverageSale.ToString("F2")</h5>
                <p class="card-text text-muted">Average Sale</p>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Sale ID</th>
                        <th>Date</th>
                        <th>Cashier</th>
                        <th>Items</th>
                        <th>Subtotal</th>
                        <th>Tax</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sale in Model.Sales)
                    {
                        <tr>
                            <td>
                                <strong>#@sale.Id.ToString("D6")</strong>
                            </td>
                            <td>@sale.SaleDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>@sale.User?.Email</td>
                            <td>
                                <span class="badge bg-secondary">@sale.SaleItems.Count items</span>
                            </td>
                            <td>$@sale.SubTotal.ToString("F2")</td>
                            <td>$@sale.TaxAmount.ToString("F2")</td>
                            <td>
                                <strong>$@sale.TotalAmount.ToString("F2")</strong>
                            </td>
                            <td>
                                @switch (sale.PaymentMethod)
                                {
                                    case "Cash":
                                        <span class="badge bg-success">@sale.PaymentMethod</span>
                                        break;
                                    case "Credit Card":
                                        <span class="badge bg-primary">@sale.PaymentMethod</span>
                                        break;
                                    case "Debit Card":
                                        <span class="badge bg-info">@sale.PaymentMethod</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@sale.PaymentMethod</span>
                                        break;
                                }
                            </td>
                            <td>
                                <a asp-page="./Details" asp-route-id="@sale.Id" class="btn btn-sm btn-outline-info">
                                    <i class="fas fa-eye"></i> Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (!Model.Sales.Any())
        {
            <div class="text-center py-4">
                <i class="fas fa-chart-line fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No sales found</h5>
                <p class="text-muted">Sales transactions will appear here once you start processing orders.</p>
                <a asp-page="/POS" class="btn btn-primary">
                    <i class="fas fa-shopping-cart me-1"></i>Start Selling
                </a>
            </div>
        }
    </div>
</div>
